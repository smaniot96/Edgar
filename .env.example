# Edgar – single source of config. Copy to .env and set values. Do not commit .env.
# ENV: local (default) | cloud. Docker Compose only overrides DB_HOST, REDIS_HOST, QDRANT_HOST.

ENV=local

DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dnd

REDIS_HOST=localhost
REDIS_PORT=6379

QDRANT_HOST=localhost
QDRANT_PORT=6333

OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional model overrides (defaults match edgar_core.config)
LLM_MODEL=gpt-6-luna
# Reasoning models only (gpt-5*/gpt-6*/o*): none | low | medium | high | xhigh
LLM_REASONING_EFFORT=low
EMBEDDING_MODEL=text-embedding-3-small

# Set to 1 to emit per-stage debug frames on turns (Developer mode). Dev only.
EDGAR_DEBUG=0
