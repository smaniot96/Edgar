# Edgar – single source of config. Copy to .env and set values. Do not commit .env.
# ENV: local (default) | cloud. Docker Compose only overrides DB_HOST, REDIS_HOST, QDRANT_HOST.

ENV=local

DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dnd

REDIS_HOST=localhost
REDIS_PORT=6379

QDRANT_HOST=localhost
QDRANT_PORT=6333

# Hosting profile only (docker-compose.hosting.yml, see docs/hosting-hardening.md). Leave these
# commented out for the local stack. The hosting profile refuses to start without all three, and
# POSTGRES_PASSWORD above must be replaced before any shared deployment.
# REDIS_PASSWORD=
# VECTOR_DB_API_KEY=

OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional compatibility defaults for play profiles. Named settings in
# config/model-profiles.toml take precedence per stage. Campaign authoring is fixed to
# gpt-6-luna / medium / Responses API by policy and ignores these play defaults.
LLM_MODEL=gpt-6-luna
# Reasoning models only (gpt-5*/gpt-6*/o*): none | low | medium | high | xhigh
LLM_REASONING_EFFORT=low
# Optional path to an external model profile TOML; defaults to config/model-profiles.toml.
# MODEL_PROFILES_PATH=/etc/edgar/model-profiles.toml
EMBEDDING_MODEL=text-embedding-3-small

# Set to 1 to emit per-stage debug frames on turns (Developer mode). Dev only.
EDGAR_DEBUG=0

# Experimental combat-grid backend (no interactive grid UI yet). Off by default; applies only
# to newly opened encounters. Persisted grid encounters keep grid rules if this is turned off.
EDGAR_COMBAT_GRID=0

# Request, upload and spend limits (EDG-066). Defaults and meanings: docs/request-limits.md.
# Uncomment to change; a malformed value stops the API at startup and names the setting only.
# LIMIT_TURNS_PER_MINUTE=30
# LIMIT_JOB_STARTS_PER_HOUR=20
# LIMIT_MAX_CONCURRENT_TURNS=8
# LIMIT_MAX_CONCURRENT_TURNS_PER_CLIENT=4
# LIMIT_MAX_CONCURRENT_JOBS=4
# LIMIT_MAX_UPLOAD_BYTES=67108864
# LIMIT_DAILY_SPEND_MICROUSD=50000000
# LIMIT_ASSUMED_CALL_COST_MICROUSD=100000
# LIMIT_UNBUDGETED_JOB_COST_MICROUSD=500000
# LIMIT_TURN_LEASE_SECONDS=300
# LIMIT_JOB_LEASE_SECONDS=7200

# Memory-summary jobs that may run at once in one API process (default 2; excess jobs queue).
# EDGAR_MEMORY_SUMMARY_CONCURRENCY=2

# --- Authentication (EDG-065). Unset or local = the single-user local app. See docs/authentication.md. ---
# EDGAR_AUTH_MODE=local
# EDGAR_AUTH_MODE=token requires EDGAR_ADMIN_USER_IDS (comma-separated user ids) and refuses EDGAR_DEBUG=1
# unless EDGAR_ALLOW_DEBUG_IN_TOKEN_MODE=1.
# EDGAR_ADMIN_USER_IDS=1
# EDGAR_ALLOW_DEBUG_IN_TOKEN_MODE=0

# Optional retained rules-PDF directory inside the container; defaults include /data/pdfs.
EDGAR_SOURCE_PDF_DIR=
