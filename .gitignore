# General
# Log files
*.log
# Process ID files
*.pid
# Swap files (created by editors like Vim)
*.swp
*.swo
# Backup files
*.bak
# Temporary files
*.tmp
*.DS_Store
# Windows specific
Thumbs.db

# Lock files (NOT uv.lock — those must be committed for reproducible builds)
package-lock.json
!frontend/package-lock.json
yarn.lock
Pipfile.lock
composer.lock

