# General
*.log            # Log files
*.pid            # Process ID files
*.swp            # Swap files (created by editors like Vim)
*.swo
*.bak            # Backup files
*.tmp            # Temporary files
*.DS_Store       # macOS specific
Thumbs.db        # Windows specific

# Lock files (NOT uv.lock — those must be committed for reproducible builds)
package-lock.json
yarn.lock
Pipfile.lock
composer.lock

# Node.js
node_modules/    # Node.js dependencies
npm-debug.log    # NPM debug log
yarn-debug.log
yarn-error.log

# Python
__pycache__/     # Python bytecode cache
*.pyc            # Python bytecode files
*.pyo            # Optimized Python bytecode files
*.pyd            # Python dynamic libraries
env/             # Virtual environments
venv/            # Python virtual environments
.venv/           # uv / pip virtual environments
.idea/           # PyCharm IDE files

# Java
*.class          # Compiled Java classes
*.jar            # Java archive files
*.war            # Web archive files
*.ear            # Enterprise archive files
target/          # Build output

# JavaScript / TypeScript
dist/            # Distribution directory (compiled code)
build/           # Build directory
coverage/        # Coverage reports
*.tsbuildinfo    # TypeScript build information

# Ruby
*.gem            # Ruby gem files
*.rbc            # Ruby compiled files
.bundle/         # Bundler directory
log/             # Log files
tmp/             # Temporary files
vendor/          # Vendor files (including dependencies)

# Go
bin/             # Go binary output
*.exe            # Executable files
*.test           # Test binaries
vendor/          # Go vendor dependencies

# Docker
*.tar            # Docker image tarballs
.docker/         # Docker build temporary files and output
docker-compose.override.yml  # Local Docker Compose overrides
*.dockerignore   # Docker ignore file

# .env files
.env             # Environment variables
.env.*           # Environment variable files (except .env.example)
!.env.example    # Committed template; copy to .env and fill in secrets
.env.local       # Local environment variables (Do not commit)

# JetBrains IDEs
.idea/           # IntelliJ, WebStorm, PhpStorm, PyCharm project files
*.iml            # IntelliJ IDEA module files

# VS Code
.vscode/         # Visual Studio Code project settings
.settings/       # Eclipse settings

# Eclipse
.project         # Eclipse project file
.classpath       # Eclipse classpath file
.idea/           # JetBrains IDE files
*.sublime-workspace
*.sublime-project

# macOS
.DS_Store        # macOS Finder specific
.AppleDouble     # macOS specific
.LSOverride      # macOS specific
Icon?            # macOS specific

# Windows
Thumbs.db        # Windows image cache
Desktop.ini      # Windows desktop configuration file

# .NET
bin/             # Compiled binary files
obj/             # Temporary object files
.vs/             # Visual Studio files
.vscode/         # Visual Studio Code configuration files

# PHP
/vendor/         # Composer dependencies
phpunit.xml      # PHPUnit configuration files

# Terraform
*.tfstate        # Terraform state files
*.tfstate.backup # Backup state files
.terraform/      # Terraform working directory

# Kubernetes
*.kube/config    # Kubernetes configuration files

# Ansible
*.retry          # Ansible retry files
*.yml~           # Backup YAML files
*.swp            # Swap files

# Bash
*.bash_history   # Bash history file
*.bash_profile   # Bash profile file

# Flutter/Dart
.dart_tool/      # Dart tools and packages
.pub/            # Pub packages
build/           # Flutter build output

# Elixir
_build/          # Elixir build output
deps/            # Elixir dependencies

# Rust
target/          # Rust build output

# Swift
.xcodeproj/      # Xcode project files
*.xcodeproj      # Xcode project files
*.xcworkspace    # Xcode workspace files
DerivedData/     # Xcode derived data

# Cloud IDE (e.g., Gitpod)
.gitpod/         # Gitpod workspace config files

# Miscellaneous
*.bak            # Backup files
*.orig           # Original files from merging or patching
*.tmp            # Temporary files created by apps or IDEs
