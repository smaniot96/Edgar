# Edgar / D&D AI DM – development environment variables
# Copy this file to .env and fill in real values. Do not commit .env.
#
# Usage:
#   - Local (host): use localhost for hostnames; load .env with python-dotenv or your shell.
#   - Docker Compose: use env_file: [.env] in docker-compose.yml so containers get these;
#     for DB/Redis/Qdrant the host inside the network is the service name (db, redis, qdrant).

# -----------------------------------------------------------------------------
# PostgreSQL (db package, Alembic, api, agent, ingestion, rules_engine)
# Use postgresql+asyncpg:// for SQLAlchemy async. Host: localhost on host, db in Docker.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dnd

# -----------------------------------------------------------------------------
# Redis (api, agent – session/turn state)
# Host: localhost on host, redis in Docker.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Qdrant vector DB (ingestion, agent – RAG embeddings)
# Use http:// for the client URL. Host: localhost on host, qdrant in Docker.
# -----------------------------------------------------------------------------
VECTOR_DB_URL=http://localhost:6333

# -----------------------------------------------------------------------------
# OpenAI (ingestion – embeddings; agent – LLM)
# Get from https://platform.openai.com/api-keys . Required for embeddings/LLM.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here

# -----------------------------------------------------------------------------
# Optional: Postgres container credentials (if you override docker-compose)
# Must match DATABASE_URL user/password/database.
# -----------------------------------------------------------------------------
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_DB=dnd
