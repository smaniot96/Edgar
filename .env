# Edgar / D&D AI DM – single source of config (no duplication with docker-compose)
# Copy to .env and set real values. Do not commit .env.
#
# ENV: local = use hosts below (localhost or Docker service names). cloud = set hosts to your cloud endpoints.
# Docker Compose: uses env_file and only overrides DB_HOST, REDIS_HOST, QDRANT_HOST to service names.

# -----------------------------------------------------------------------------
# Runtime (local | cloud)
# -----------------------------------------------------------------------------
ENV=local

# -----------------------------------------------------------------------------
# PostgreSQL – credentials + host/port (config.py builds DATABASE_URL from these)
# Local: DB_HOST=localhost. Docker: override to DB_HOST=db in compose.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dnd

# -----------------------------------------------------------------------------
# Redis – host/port
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Qdrant – host/port
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

# -----------------------------------------------------------------------------
# Secrets (only here, never in docker-compose)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
# VECTOR_DB_API_KEY=   # optional, for Qdrant Cloud
