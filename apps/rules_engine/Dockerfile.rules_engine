FROM python:3.12-slim-trixie
COPY --from=ghcr.io/astral-sh/uv:0.6.6 /uv /uvx /bin/

# Full workspace structure
WORKDIR /workspace
COPY . /workspace/

# Install app dependencies (tools removed from pyproject to avoid path resolution in Docker)
WORKDIR /workspace/apps/rules_engine
RUN uv sync --locked --no-install-project

# Install tools and db via pip (path deps that don't work with uv in Docker)
RUN uv pip install -e /workspace/tools /workspace/db

# config at /workspace for 'from config import ...' via PYTHONPATH
ENV PYTHONPATH=/workspace

CMD ["uv", "run", "python", "rules_engine.py"]
