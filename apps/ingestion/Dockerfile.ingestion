FROM python:3.12-slim-trixie
COPY --from=ghcr.io/astral-sh/uv:0.6.6 /uv /uvx /bin/

# Copy workspace so path dep ../../db resolves (apps/ingestion -> db)
WORKDIR /workspace
COPY db/ /workspace/db/
COPY apps/ingestion/pyproject.toml apps/ingestion/uv.lock /workspace/apps/ingestion/
COPY config.py /workspace/config.py

# Install ingestion (path ../../db from apps/ingestion = /workspace/db)
WORKDIR /workspace/apps/ingestion
RUN uv sync --locked --no-install-project
COPY apps/ingestion/ /workspace/apps/ingestion/
RUN uv sync --locked

# config.py at /workspace for imports
ENV PYTHONPATH=/workspace

WORKDIR /workspace
ENTRYPOINT ["uv", "run", "--project", "apps/ingestion", "ingest"]
CMD ["--help"]
