FROM python:3.12-slim-trixie
COPY --from=ghcr.io/astral-sh/uv:0.6.6 /uv /uvx /bin/

WORKDIR /app

# Install app dependencies (creates /app/.venv)
COPY apps/api/pyproject.toml apps/api/uv.lock /app/
RUN uv sync --locked --no-install-project

# Install shared db package into the same venv (brings sqlalchemy, asyncpg, python-dotenv, etc.)
COPY db/ /tmp/db/
RUN uv pip install /tmp/db

# config.py must be in /app so 'from config import ...' resolves when /app is on sys.path
COPY config.py /app/config.py

# Copy app code and finalize
COPY apps/api/ /app/
RUN uv sync --locked

EXPOSE 8000
CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
