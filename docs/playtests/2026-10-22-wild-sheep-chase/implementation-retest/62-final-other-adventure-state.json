    {
      "role": "user",
      "content": "Elin, what happened to the lantern, and what do you need me to do?",
      "event_id": 464,
      "citations": [],
      "rules_edition": null,
      "ruling_citation_ids": [],
      "turn_id": null,
      "roll_status": null,
      "roll": null,
