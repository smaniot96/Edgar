    {
      "role": "user",
      "content": "I stand between Finethir and the approaching noise, draw my sword, and wait for the pursuers to arrive.",
      "event_id": 400,
      "citations": [],
      "rules_edition": null,
      "ruling_citation_ids": [],
      "turn_id": null,
      "roll_status": null,
      "roll": null,
