    {
      "role": "user",
      "content": "I read the scroll aloud and listen to the sheep.",
      "event_id": 391,
      "citations": [],
      "rules_edition": null,
      "ruling_citation_ids": [],
      "turn_id": null,
      "roll_status": null,
      "roll": null,
