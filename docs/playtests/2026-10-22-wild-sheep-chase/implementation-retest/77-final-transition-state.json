  "messages": [
    {
      "role": "dm",
      "content": "Aspen Desktop Continuity Verification L4, clattering hooves and surprised yelps cut through the afternoon. Frantic bleating follows, close enough to draw your attention toward a fluffy white sheep bounding toward your group.\n\nIt has a black face and curled horns. An ornate scroll is held in its mouth, and as the sheep comes near, it waves the scroll toward you.\n\nThe sheep is right here, the scroll plainly visible between its jaws. What do you do?",
      "event_id": 545,
      "citations": [
        {
          "page": 1,
          "source": "wild_sheep_chase_chapter_source_fidelity_demonstration",
          "audience": "player",
